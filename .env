# Application
APP_NAME=InfinityInsight
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-characters-long
JWT_SECRET_KEY=change-this-jwt-secret-to-secure-random-string-32-chars

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database (SQLite for easy setup - change to PostgreSQL for production)
DATABASE_URL=sqlite:///./infinityinsight.db

# Redis (optional - comment out if not using)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=./data/uploads

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000"]

# AI/LLM (optional - leave empty if not using)
OPENAI_API_KEY=
LLM_MODEL=gpt-4
ENABLE_NL_INTERFACE=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# S3 (optional)
USE_S3=False
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
