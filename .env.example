# Application Settings
APP_NAME=InfinityInsight
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database Settings
DATABASE_URL=postgresql://infinity:infinity123@localhost:5432/infinityinsight
DB_ECHO=False

# Redis Settings (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Settings
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=./data/uploads

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# AI/LLM Settings (OpenAI or other)
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4
ENABLE_NL_INTERFACE=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Email Settings (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@infinityinsight.com

# S3/Object Storage (optional)
USE_S3=False
S3_BUCKET=infinityinsight
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1
